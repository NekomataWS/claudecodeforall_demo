# Payment mode: mock | sandbox | production
PAYMENT_MODE=mock

# Server
PORT=3000
BASE_URL=http://localhost:3000

# Coffee shop callback URLs (must be HTTPS in production)
COFFEE_FRONTEND_RETURN_URL=http://localhost:3000/payment-result.html
COFFEE_BACKEND_RETURN_URL=http://localhost:3000/api/payments/2c2p/callback

# 2C2P credentials — required for sandbox/production only
# Obtain Sandbox MID and keys from 2C2P before setting these.
# Confirm with 2C2P that this MID is approved for the coffee shop website.
# NEVER share these values or commit them to version control.
# TWO_C_TWO_P_MERCHANT_ID=
# TWO_C_TWO_P_SECRET_KEY=
